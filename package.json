{
  "name": "swamplight",
  "private": true,
  "version": "0.1.0",
  "description": "An Earthbound-inspired Florida cryptid RPG.",
  "author": "SWAMPLIGHT",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "desktop": "vite build && electron .",
    "icon": "node scripts/make-icon.mjs",
    "dist:win": "vite build && electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "26.0.12",
    "phaser": "3.90.0",
    "typescript": "5.8.3",
    "vite": "6.4.5",
    "vitest": "3.2.7"
  },
  "build": {
    "appId": "com.frownyface.swamplight",
    "productName": "SWAMPLIGHT",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "SWAMPLIGHT-${version}-portable.exe"
    },
    "linux": {
      "target": "dir"
    }
  }
}
